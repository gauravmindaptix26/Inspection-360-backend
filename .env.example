# Copy this file to .env and replace these example values on your server.
# Do not commit the real .env file to GitHub.

DJANGO_SECRET_KEY=django-insecure-example-only-change-this-before-deploying-1234567890
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# Use sqlite for local development, mysql for production/RDS.
DJANGO_DB=mysql
SQLITE_DB_PATH=db.sqlite3

MYSQL_DATABASE=inspection_db
MYSQL_USER=inspection_user
MYSQL_PASSWORD=example-db-password-change-me
MYSQL_HOST=example-db-host.amazonaws.com
MYSQL_PORT=3306

BASE_URL=http://localhost:8000

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,https://example.com

